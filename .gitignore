# ==========================================
# 校园宿舍管理系统 - 仓库根级忽略规则
# ==========================================

# ---------- Java / Maven 构建产物 ----------
target/
build/
out/
*.class
*.jar
*.war
*.ear
*.nar

# ---------- 前端依赖与构建产物 ----------
node_modules/
dist/
dist-ssr/
.vite/
coverage/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- IDE / 编辑器配置（含本机路径、账号信息）----------
.idea/
*.iml
*.ipr
*.iws
.vscode/
!.vscode/extensions.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ---------- 日志 ----------
logs/
*.log
*.log.*

# ---------- 运行时产物 ----------
uploads/
*.pid
*.tmp
*.temp
*~

# ---------- 操作系统文件 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 环境变量与本地密钥（禁止入库）----------
.env
.env.*
*.local
application-local.yml
application-local.yaml
application-secret.yml
application-secret.yaml
*.pem
*.key
*.p12
*.jks
