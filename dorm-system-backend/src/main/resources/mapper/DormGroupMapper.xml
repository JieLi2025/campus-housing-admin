<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campus.dorm.mapper.DormGroupMapper">
    
    <!-- 结果映射，显式指定 members 字段类型 -->
    <resultMap id="BaseResultMap" type="com.campus.dorm.entity.DormGroup">
        <id column="id" property="id" jdbcType="BIGINT"/>
        <result column="group_name" property="groupName" jdbcType="VARCHAR"/>
        <result column="leader_name" property="leaderName" jdbcType="VARCHAR"/>
        <result column="leader_id" property="leaderId" jdbcType="BIGINT"/>
        <result column="member_count" property="memberCount" jdbcType="INTEGER"/>
        <result column="max_members" property="maxMembers" jdbcType="INTEGER"/>
        <result column="major" property="major" jdbcType="VARCHAR"/>
        <result column="class_name" property="className" jdbcType="VARCHAR"/>
        <result column="gender" property="gender" jdbcType="VARCHAR"/>
        <result column="room_type" property="roomType" jdbcType="VARCHAR"/>
        <result column="status" property="status" jdbcType="VARCHAR"/>
        <result column="room_id" property="roomId" jdbcType="BIGINT"/>
        <result column="building_id" property="buildingId" jdbcType="BIGINT"/>
        <!-- 关键：显式指定 members 为 VARCHAR，而不是 BLOB -->
        <result column="members" property="members" jdbcType="VARCHAR"/>
        <result column="creation_type" property="creationType" jdbcType="VARCHAR"/>
        <result column="remarks" property="remarks" jdbcType="VARCHAR"/>
        <result column="deleted" property="deleted" jdbcType="TINYINT"/>
    </resultMap>

</mapper>

